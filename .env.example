# Copy this file to ".env" (same folder) and fill in your values.
# The backend loads .env automatically on startup. .env is git-ignored.

# --- Google Gemini fallback (used when Ollama isn't running) ---
# Get a key at https://aistudio.google.com/apikey  (leave blank to skip Gemini)
GEMINI_API_KEY=
# Optional: pin a model (default is gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# --- Trained model paths (so you don't pass them on the command line) ---
TEXT_MODEL_DIR=models/weights/text
# resnet18.pt is the current face model. face_net.pt is the old baseline CNN and will
# NOT load -- it fails with a state_dict mismatch and silently serves the stub instead
# (a constant "neutral 0.60"). Check with: curl localhost:8000/health | grep face
FACE_MODEL_PATH=models/weights/face/resnet18.pt

# --- Which LLM writes the replies -------------------------------------------------
#   auto     (default) Ollama if it's running, else Gemini if a key is set, else template
#   ollama   force local Ollama
#   gemini   force Google Gemini (needs GEMINI_API_KEY above)
#   template no LLM at all -- canned empathetic replies, always works offline
LLM_BACKEND=auto

# Which Ollama model to use. Setting this PINS it: if that exact model isn't pulled the
# backend warns and falls back to Gemini/template, rather than quietly running a
# different model of the same family. Leave it commented out to let the backend use
# whatever chat model you already have pulled.
#   ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b

# Where Ollama listens (default is fine unless you moved it)
# OLLAMA_URL=http://localhost:11434

# Seconds to wait for a reply before giving up and answering from the offline template.
# A 7B model on a CPU-only laptop can take minutes; raise this, or pull a smaller model.
# LLM_TIMEOUT=120
